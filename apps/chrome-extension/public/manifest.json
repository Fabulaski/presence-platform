{
  "manifest_version": 3,
  "name": "Presence Platform — Spiritual Wellness & Scripture",
  "version": "1.0.0",
  "description": "Proactive biblical wisdom, inner peace, and devotional reflections tailored to your browsing workflow.",
  "permissions": [
    "tabs",
    "idle",
    "notifications",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost:*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Presence Platform"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
