# ==============================================================================
# PRESENCE PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database / Supabase PostgreSQL Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/presence_db?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/presence_db?schema=public"

# Supabase Platform Credentials
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Integrations
YOUVERSION_API_KEY="your-youversion-platform-key"
GLOO_API_KEY="your-gloo-ai-gateway-key"
GLOO_AGENT_ENDPOINT="https://api.gloo.us/v1/agents"

# Application Settings
NODE_ENV="development"
PORT=3001
PRESENCE_SDK_DEBUG=true
